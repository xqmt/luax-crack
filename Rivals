    if fakePosConn then fakePosConn:Disconnect(); fakePosConn = nil end
    if fakePosRender then fakePosRender:Disconnect(); fakePosRender = nil end
    fakePosRealCF = nil; fakeCFG.enabled = false
end

local translocConn, translocRender = nil, nil
local translocRealCF = nil
local translocPingPongDir = 1
local translocWaveT = 0

local function getTranslocFakePos(realCF, index)
    local d = translocCFG.offsetDist
    local jmp = translocCFG.jitter and translocCFG.jitterAmp or 0
    local base = realCF.Position
    local ox, oy, oz = 0, 0, 0
    local m = translocCFG.offsetMode

    if translocCFG.wavePattern then
        translocWaveT = translocWaveT + 0.01
        d = d + math.sin(translocWaveT * translocCFG.waveFreq * 2 * math.pi) * translocCFG.waveAmp
    end

    if translocCFG.pingPong then
        d = d * translocPingPongDir
    end

    if translocCFG.cascadeOffset and index then
        d = d + (index - 1) * translocCFG.cascadeStep
    end

    if translocCFG.noiseOffset then
        local t = tick() + translocCFG.noiseSeed
        d = d + math.noise(t, 0, 0) * jmp
    end

    if m == "Random" then
        local sx = math.random() < 0.5 and 1 or -1
        local sz = math.random() < 0.5 and 1 or -1
        ox = sx * (math.abs(d) + (math.random() - 0.5) * jmp)
        oz = sz * (math.abs(d) + (math.random() - 0.5) * jmp)
        oy = translocCFG.offsetY + (math.random() - 0.5) * jmp * 0.3
    elseif m == "Opposite" then
        local look = realCF.LookVector
        ox = -look.X * d + (math.random() - 0.5) * jmp
        oz = -look.Z * d + (math.random() - 0.5) * jmp
        oy = translocCFG.offsetY
    elseif m == "Perpendicular" then
        local right = realCF.RightVector
        local side = math.random() < 0.5 and 1 or -1
        ox = right.X * d * side + (math.random() - 0.5) * jmp
        oz = right.Z * d * side + (math.random() - 0.5) * jmp
        oy = translocCFG.offsetY
    elseif m == "Above" then
        ox = (math.random() - 0.5) * jmp; oy = math.abs(d) + translocCFG.offsetY; oz = (math.random() - 0.5) * jmp
    elseif m == "Below" then
        ox = (math.random() - 0.5) * jmp; oy = -math.abs(d) + translocCFG.offsetY; oz = (math.random() - 0.5) * jmp
    end

    if translocCFG.invertAxis then oy = -oy end

    if translocCFG.spinFake then
        local spinAng = tick() * math.rad(translocCFG.spinFakeSpeed)
        local newX = ox * math.cos(spinAng) - oz * math.sin(spinAng)
        local newZ = ox * math.sin(spinAng) + oz * math.cos(spinAng)
        ox = newX; oz = newZ
    end

    if translocCFG.mirrorFake then
        ox = -ox; oz = -oz
    end

    return CFrame.new(base.X + ox, base.Y + oy, base.Z + oz)
end

function startTransloc()
    if translocConn then translocConn:Disconnect() end
    if translocRender then translocRender:Disconnect() end
    translocRealCF = nil; translocPingPongDir = 1; translocWaveT = 0
    local acc = 0
    local pingPongTimer = 0

    translocConn = RunService.Heartbeat:Connect(function(dt)
        if not translocCFG.enabled then stopTransloc(); return end
        if not root then return end
        translocRealCF = root.CFrame
        acc = acc + dt
        pingPongTimer = pingPongTimer + dt

        if translocCFG.pingPong and pingPongTimer > 0.5 then
            pingPongTimer = 0; translocPingPongDir = -translocPingPongDir
        end

        local interval
        if translocCFG.randomFrequency then
            interval = 1 / (translocCFG.freqMin + math.random() * (translocCFG.freqMax - translocCFG.freqMin))
        else
            interval = 1 / math.max(translocCFG.frequency, 1)
        end

        if acc < interval then return end
        acc = acc % interval

        local mt = getrawmetatable and getrawmetatable(root)
        local ni = mt and rawget(mt, "__newindex")

        local layerCount = math.max(translocCFG.layers, 1)
        local burstCount = translocCFG.burstMode and translocCFG.burstCount or 1

        for b = 1, burstCount do
            for i = 1, layerCount do
                local fcf = getTranslocFakePos(translocRealCF, i)
                local fv = Vector3.zero
                if translocCFG.fakeVel then
                    local mag = translocCFG.fakeVelMag
                    fv = Vector3.new((math.random()-0.5)*mag*2, (math.random()-0.5)*mag*2, (math.random()-0.5)*mag*2)
                end
                if ni then
                    pcall(ni, root, "CFrame", fcf)
                    pcall(ni, root, "AssemblyLinearVelocity", fv)
                else
                    pcall(function() root.CFrame = fcf; root.AssemblyLinearVelocity = fv end)
                end
            end

            if translocCFG.teleportStorm then
                for _ = 1, translocCFG.stormCount do
                    local stormCF = getTranslocFakePos(translocRealCF, nil)
                    if ni then pcall(ni, root, "CFrame", stormCF)
                    else pcall(function() root.CFrame = stormCF end) end
                end
            end

            if b < burstCount then task.wait(translocCFG.burstInterval) end
        end

        if translocCFG.snapBack then
            if ni then
                pcall(ni, root, "CFrame", translocRealCF)
                pcall(ni, root, "AssemblyLinearVelocity", Vector3.zero)
            else
                pcall(function() root.CFrame = translocRealCF; root.AssemblyLinearVelocity = Vector3.zero end)
            end
        end
    end)

    translocRender = RunService.RenderStepped:Connect(function()
        if translocCFG.enabled and root and translocRealCF then
            root.CFrame = translocRealCF
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end
function stopTransloc()
    if translocConn then translocConn:Disconnect(); translocConn = nil end
    if translocRender then translocRender:Disconnect(); translocRender = nil end
    translocCFG.enabled = false; translocRealCF = nil
end

local slingConn, slingRenderConn = nil, nil

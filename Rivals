                            if now - lastDodgeTick > cfgDodge.predCooldown then
                                lastDodgeTick = now
                                local dir = perpDodgeDir(hrp.Position, myPos)
                                root.CFrame = CFrame.new(myPos + dir * cfgDodge.predShootDist)
                                Notify("shot dodge: " .. p.Name, 1.2); break
                            end
                        end
                    end
                end
            end

            if not tHrp then return end
            local tp = tHrp.Position + Vector3.new(0, slingCFG.stickHeight, 0)
            local uv = slingCFG.useTargetVel and tHrp.AssemblyLinearVelocity or Vector3.zero
            local fcf = CFrame.new(tp)
            if ni then pcall(ni, root, "CFrame", fcf); pcall(ni, root, "AssemblyLinearVelocity", uv)
            else pcall(function() root.CFrame = fcf; root.AssemblyLinearVelocity = uv end) end
            doAutoShoot(target)
        elseif mode == "OrbitTarget" then
            if not target or not target.Character then return end
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not tHrp then return end
            slingOrbAng = (slingOrbAng + math.rad(slingCFG.orbitSpeed) * dt) % (2 * math.pi)
            local off = Vector3.new(math.cos(slingOrbAng)*slingCFG.orbitRadius, slingCFG.orbitHeight, math.sin(slingOrbAng)*slingCFG.orbitRadius)
            local fcf = CFrame.new(tHrp.Position + off)
            local uv = slingCFG.useTargetVel and tHrp.AssemblyLinearVelocity or Vector3.zero
            if ni then pcall(ni, root, "CFrame", fcf); pcall(ni, root, "AssemblyLinearVelocity", uv)
            else pcall(function() root.CFrame = fcf; root.AssemblyLinearVelocity = uv end) end
            doAutoShoot(target)
        elseif mode == "RandomAroundTarget" then
            if not target or not target.Character then return end
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not tHrp then return end
            local a = math.random() * 2 * math.pi
            local fcf = CFrame.new(tHrp.Position + Vector3.new(math.cos(a)*slingCFG.randomRadius, slingCFG.stickHeight, math.sin(a)*slingCFG.randomRadius))
            local uv = slingCFG.useTargetVel and tHrp.AssemblyLinearVelocity or Vector3.zero
            if ni then pcall(ni, root, "CFrame", fcf); pcall(ni, root, "AssemblyLinearVelocity", uv)
            else pcall(function() root.CFrame = fcf; root.AssemblyLinearVelocity = uv end) end
            doAutoShoot(target)
        end
    end)

    slingRenderConn = RunService.RenderStepped:Connect(function()
        if slingCFG.enabled and root and slingCFG.visualSpawn then
            root.CFrame = CFrame.new(slingCFG.spawnX, slingCFG.spawnY, slingCFG.spawnZ)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

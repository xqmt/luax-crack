function startSlingBypass()
    if slingConn then slingConn:Disconnect() end
    if slingRenderConn then slingRenderConn:Disconnect() end
    slingRealCF = nil; slingLastShot = 0; slingOrbAng = 0; slingLastRush = 0

    slingConn = RunService.Heartbeat:Connect(function(dt)
        if not slingCFG.enabled then stopSlingBypass(); return end
        if not root then return end
        slingRealCF = root.CFrame
        local now = tick()
        local target = getTarget(slingCFG.targetMode)
        pcall(function() root:SetNetworkOwner(LocalPlayer) end)
        local mt = getrawmetatable and getrawmetatable(root)
        local ni = mt and rawget(mt, "__newindex")
        local mode = slingCFG.mode

        if mode == "FastTp" then
            if not target or not target.Character then return end
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if not tHrp then return end
            if now - slingLastRush < slingCFG.rushCooldown then return end
            slingLastRush = now
            local count = slingCFG.fastTpMulti and slingCFG.fastTpCount or 1
            for i = 1, count do
                local predicted = predictPos(tHrp, slingCFG.fastTpSpeed * 3)
                local jx = (math.random() - 0.5) * slingCFG.fastTpJitter * 2
                local jz = (math.random() - 0.5) * slingCFG.fastTpJitter * 2
                local tp = predicted + Vector3.new(jx, slingCFG.stickHeight, jz)
                if slingCFG.fastTpRandAng then
                    local a = math.random() * 2 * math.pi
                    tp = tp + Vector3.new(math.cos(a) * slingCFG.fastTpOffset, 0, math.sin(a) * slingCFG.fastTpOffset)
                end
                local useVel = slingCFG.useTargetVel and tHrp.AssemblyLinearVelocity or Vector3.zero
                if slingCFG.fakeVelocity then
                    local mag = slingCFG.fakeVelMag
                    useVel = Vector3.new((math.random()-0.5)*mag*2, (math.random()-0.5)*mag*2, (math.random()-0.5)*mag*2)
                end
                local fcf = CFrame.new(tp)
                if ni then pcall(ni, root, "CFrame", fcf); pcall(ni, root, "AssemblyLinearVelocity", useVel)
                else pcall(function() root.CFrame = fcf; root.AssemblyLinearVelocity = useVel end) end
                if i < count then task.wait(slingCFG.fastTpSpeed) end
            end
            doAutoShoot(target)
            if slingCFG.fastTpPenetrate then
                if ni then pcall(ni, root, "CFrame", slingRealCF); pcall(ni, root, "AssemblyLinearVelocity", Vector3.zero)
                else pcall(function() root.CFrame = slingRealCF; root.AssemblyLinearVelocity = Vector3.zero end) end
            end
        elseif mode == "TargetStick" then

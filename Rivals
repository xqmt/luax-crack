    if fakePosRender then fakePosRender:Disconnect() end
    fakePosRealCF = nil; fakeSpiralAng = 0; fakeLinearT = 0; fakeLastPkt = 0; fakePulseT = 0

    fakePosConn = RunService.Heartbeat:Connect(function(dt)
        if not fakeCFG.enabled or not root then return end
        fakePosRealCF = root.CFrame
        fakePulseT = fakePulseT + dt
        local now = tick()
        local spd = fakeCFG.randomizeEveryFrame and 99999 or math.max(fakeCFG.speed, 1)
        if now - fakeLastPkt < (1 / spd) then return end
        fakeLastPkt = now

        local mt = getrawmetatable and getrawmetatable(root)
        local ni = mt and rawget(mt, "__newindex")
        local r = math.max(fakeCFG.radius, 1)

        if fakeCFG.pulseRadius then
            r = fakeCFG.pulseRadiusMin + (math.sin(fakePulseT * fakeCFG.pulseSpeed * 2 * math.pi) * 0.5 + 0.5) * (fakeCFG.pulseRadiusMax - fakeCFG.pulseRadiusMin)
        end

        local layerCount = fakeCFG.layeredFake and fakeCFG.layerCount or 1

        for layer = 1, layerCount do
            local ox, oy, oz = 0, 0, 0
            local lr = r * (layer / layerCount)

            if fakeCFG.chaosMode then lr = lr * (1 + (math.random() - 0.5) * fakeCFG.chaosMult) end

            if fakeCFG.pattern == "Scatter" then
                local scatterAng = math.rad(fakeCFG.scatterAngle)
                local a = (math.random() - 0.5) * scatterAng
                local sx = math.cos(a); local sz = math.sin(a)
                ox = sx * (math.random() * lr); oy = fakeCFG.height + math.random() * fakeCFG.yDist; oz = sz * (math.random() * lr)
            elseif fakeCFG.pattern == "Linear" then
                fakeLinearT = fakeLinearT + 0.05
                local t = fakeLinearT % 1
                ox = (t - 0.5) * 2 * lr; oy = fakeCFG.height + math.random() * fakeCFG.yDist; oz = (t - 0.5) * 2 * lr
            elseif fakeCFG.pattern == "Circle" then
                fakeSpiralAng = (fakeSpiralAng + math.rad(fakeCFG.speed * dt * 60)) % (2 * math.pi)
                ox = math.cos(fakeSpiralAng) * lr; oy = fakeCFG.height + math.random() * fakeCFG.yDist; oz = math.sin(fakeSpiralAng) * lr
            elseif fakeCFG.pattern == "Random" then
                ox = (math.random() * 2 - 1) * lr; oy = fakeCFG.height + math.random() * fakeCFG.yDist; oz = (math.random() * 2 - 1) * lr
            elseif fakeCFG.pattern == "Spiral" then
                fakeSpiralAng = (fakeSpiralAng + math.rad(fakeCFG.speed * dt * 60)) % (2 * math.pi)
                local sr = lr * (0.3 + 0.7 * (fakeSpiralAng / (2 * math.pi) % 1))
                ox = math.cos(fakeSpiralAng) * sr; oy = fakeCFG.height + math.random() * fakeCFG.yDist; oz = math.sin(fakeSpiralAng) * sr
            end

            if fakeCFG.distribution == "Uniform" then
                local mag = math.sqrt(ox * ox + oz * oz)
                if mag > 0 then local s = lr / mag; ox = ox * s; oz = oz * s end
            elseif fakeCFG.distribution == "Weighted" then ox = ox * 0.6; oz = oz * 0.6
            elseif fakeCFG.distribution == "Radial" then
                local theta = math.atan2(oz, ox); ox = math.cos(theta) * lr; oz = math.sin(theta) * lr
            elseif fakeCFG.distribution == "Clustered" then
                local ca = math.floor(math.random() * 8) * (math.pi * 0.25)
                ox = math.cos(ca) * lr; oz = math.sin(ca) * lr
            end

            if fakeCFG.axisLock == "X" then oz = 0; oy = fakeCFG.height
            elseif fakeCFG.axisLock == "Y" then ox = 0; oz = 0
            elseif fakeCFG.axisLock == "Z" then ox = 0; oy = fakeCFG.height
            elseif fakeCFG.axisLock == "XZ" then oy = fakeCFG.height end

            local fcf = fakePosRealCF + Vector3.new(ox, oy, oz)
            if ni then
                pcall(ni, root, "AssemblyLinearVelocity", Vector3.zero)
                pcall(ni, root, "CFrame", fcf)
                pcall(ni, root, "AssemblyLinearVelocity", Vector3.zero)
            else
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = fcf
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end)

    fakePosRender = RunService.RenderStepped:Connect(function()
        if fakeCFG.enabled and root and fakePosRealCF then
            root.CFrame = fakePosRealCF
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end
